<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.emts.vitrualcompiler.HelloController">

    <!-- HEADER / TOP SECTION -->
    <top>
        <VBox styleClass="main-header" spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 12px; -fx-background-color: #2d2d2d;">

                <!-- Title -->
                <Label text="Compiler IDE" styleClass="main-header-title" />

                <Separator orientation="VERTICAL" styleClass="header-separator" />

                <!-- File Operations Buttons -->
                <Button text="➕ New" styleClass="file-button, toolbar-button" onAction="#handleNew" />
                <Button text="📁 Open" styleClass="file-button, toolbar-button" onAction="#handleOpen" />
                <Button text="💾 Save" styleClass="file-button, toolbar-button" onAction="#handleSave" />

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- Execution Buttons -->
                <Button text="▶️ Run" styleClass="run-button, toolbar-button" onAction="#handleRun" />
                <Button text="⏹️ Stop" styleClass="stop-button, toolbar-button" onAction="#handleStop" />
                <Button text="🔄 Clear" styleClass="clear-button, toolbar-button" onAction="#handleClear" />
            </HBox>
        </VBox>
    </top>

    <!-- MAIN CONTENT AREA -->
    <center>
        <SplitPane dividerPositions="0.5" styleClass="main-content">

            <!-- LEFT SIDE: CODE EDITOR -->
            <VBox spacing="8" styleClass="code-editor-section">
                <Label text="📝 Source Code" styleClass="section-label" />

                <TextArea
                        fx:id="codeEditor"
                        wrapText="true"
                        styleClass="code-editor"
                        VBox.vgrow="ALWAYS">
                    <font>
                        <Font name="JetBrains Mono" size="13" />
                    </font>
                </TextArea>

                <HBox spacing="5" alignment="CENTER_RIGHT">
                    <Label fx:id="lineCountLabel" text="Lines: 0 | Chars: 0" styleClass="info-label" />
                </HBox>
            </VBox>

            <!-- RIGHT SIDE: OUTPUT TABS -->
            <VBox spacing="8" styleClass="output-section">

                <!-- Tab Pane -->
                <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="tab-pane">

                    <!-- Compilation Tab -->
                    <Tab text="🔍 Compilation" closable="false" styleClass="tab">
                        <VBox spacing="8" style="-fx-padding: 12px;">
                            <Label text="Compilation Process:" styleClass="section-label" />
                            <TextArea
                                    fx:id="compilationOutput"
                                    wrapText="true"
                                    editable="false"
                                    styleClass="compilation-output, output-area"
                                    VBox.vgrow="ALWAYS">
                                <font>
                                    <Font name="JetBrains Mono" size="12" />
                                </font>
                            </TextArea>
                            <ProgressBar fx:id="compilationProgress" progress="0" styleClass="progress-bar" prefHeight="8" />
                        </VBox>
                    </Tab>

                    <!-- Tokens Tab -->
                    <Tab text="⚙️ Tokens" closable="false" styleClass="tab">
                        <VBox spacing="8" style="-fx-padding: 12px;">
                            <Label text="Lexical Analysis:" styleClass="section-label" />
                            <TextArea
                                    fx:id="tokensOutput"
                                    wrapText="true"
                                    editable="false"
                                    styleClass="tokens-output, output-area"
                                    VBox.vgrow="ALWAYS">
                                <font>
                                    <Font name="JetBrains Mono" size="12" />
                                </font>
                            </TextArea>
                        </VBox>
                    </Tab>

                    <!-- AST Tab -->
                    <Tab text="🌳 AST" closable="false" styleClass="tab">
                        <VBox spacing="8" style="-fx-padding: 12px;">
                            <Label text="Abstract Syntax Tree:" styleClass="section-label" />
                            <TextArea
                                    fx:id="astOutput"
                                    wrapText="true"
                                    editable="false"
                                    styleClass="ast-output, output-area"
                                    VBox.vgrow="ALWAYS">
                                <font>
                                    <Font name="JetBrains Mono" size="12" />
                                </font>
                            </TextArea>
                        </VBox>
                    </Tab>

                    <!-- Output Tab -->
                    <Tab text="✅ Output" closable="false" styleClass="tab">
                        <VBox spacing="8" style="-fx-padding: 12px;">
                            <Label text="Program Output:" styleClass="section-label" />
                            <TextArea
                                    fx:id="programOutput"
                                    wrapText="true"
                                    editable="false"
                                    styleClass="program-output, output-area"
                                    VBox.vgrow="ALWAYS">
                                <font>
                                    <Font name="JetBrains Mono" size="12" />
                                </font>
                            </TextArea>
                        </VBox>
                    </Tab>

                    <!-- Errors Tab -->
                    <Tab text="❌ Errors" closable="false" styleClass="tab">
                        <VBox spacing="8" style="-fx-padding: 12px;">
                            <Label text="Errors &amp; Warnings:" styleClass="section-label" />
                            <TextArea
                                    fx:id="errorsOutput"
                                    wrapText="true"
                                    editable="false"
                                    styleClass="errors-output, output-area"
                                    VBox.vgrow="ALWAYS">
                                <font>
                                    <Font name="JetBrains Mono" size="12" />
                                </font>
                            </TextArea>
                        </VBox>
                    </Tab>
                </TabPane>
            </VBox>
        </SplitPane>
    </center>

    <!-- FOOTER / STATUS BAR -->
    <bottom>
        <HBox styleClass="status-bar" spacing="15" alignment="CENTER_LEFT">
            <Label fx:id="statusLabel" text="Ready" styleClass="status-label" />
            <Separator orientation="VERTICAL" styleClass="separator" />
            <Label fx:id="timeLabel" text="Time: 0ms" styleClass="time-label" />
            <Label fx:id="errorCountLabel" text="Errors: 0" styleClass="error-count-label" />
        </HBox>
    </bottom>

</BorderPane>